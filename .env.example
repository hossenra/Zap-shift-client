# Copy to .env.local and fill in your values. Never commit the real file.

# Backend API (no trailing slash)
VITE_API_URL=http://localhost:4000

# Firebase web app config (Firebase Console -> Project settings -> Your apps)
VITE_apiKey=
VITE_authDomain=
VITE_projectId=
VITE_storageBucket=
VITE_messagingSenderId=
VITE_appId=

# imgbb API key for profile image uploads
VITE_image_upload_key=

# Stripe publishable key (starts with pk_test_ or pk_live_)
VITE_payment_key=
